{
  "name": "guycad",
  "productName": "GuyCAD",
  "version": "2.0.0",
  "description": "GuyCAD - a parametric 3D CAD modeler for the desktop",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && node electron/launch.cjs",
    "dist": "vite build && electron-builder --win",
    "test": "node tests/kernel.test.mjs && node tests/constraints.test.mjs && node tests/sketch-tools.test.mjs && node tests/assembly.test.mjs"
  },
  "author": "Guy Gilboa",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "replicad": "^1.1.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.170.0",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.guygilboa.guycad",
    "productName": "GuyCAD",
    "copyright": "Copyright © 2026 Guy Gilboa",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "gcad",
        "name": "GuyCAD Part",
        "description": "GuyCAD Part",
        "icon": "electron/icon.png"
      },
      {
        "ext": "gasm",
        "name": "GuyCAD Assembly",
        "description": "GuyCAD Assembly",
        "icon": "electron/icon.png"
      }
    ],
    "win": {
      "icon": "electron/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GuyCAD",
      "artifactName": "GuyCAD-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "GuyCAD-${version}-portable.exe"
    }
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "electron@33.2.1": true
  }
}
